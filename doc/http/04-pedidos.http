# =====================================================================
# 04 - PEDIDOS: flujo de usuario (mis pedidos) y de administrador (12 rutas)
# POST solo existe en /api/pedidos/me (tambien el admin crea el suyo ahi).
# El id del pedido es un string (ObjectId de MongoDB).
# =====================================================================

@baseUrl = http://localhost:5031

### [LOGIN] Usuario (200) - token como loginUser
# @name loginUser
POST {{baseUrl}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "userdaw",
  "password": "userdaw"
}

### [LOGIN] Admin (200) - token como loginAdmin
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

# ------------------------- USUARIO (USER) -------------------------

### [POST] Crear mi pedido (201) - id como crearPedido
# @name crearPedido
POST {{baseUrl}}/api/pedidos/me
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{
  "destinatario": {
    "nombreCompleto": "Juan Perez",
    "email": "juanperez@test.com",
    "telefono": "+34123456789",
    "direccion": {
      "calle": "Calle Mayor",
      "numero": "10",
      "ciudad": "Madrid",
      "provincia": "Madrid",
      "pais": "España",
      "codigoPostal": "28001"
    }
  },
  "items": [
    {
      "productoId": 1,
      "cantidad": 2,
      "precioUnitario": 999.99
    }
  ]
}

### [POST] Error: sin token (401)
POST {{baseUrl}}/api/pedidos/me
Content-Type: application/json

{
  "destinatario": {
    "nombreCompleto": "Sin auth",
    "email": "sin@test.com",
    "telefono": "+34123456789",
    "direccion": {
      "calle": "Calle Test",
      "numero": "1",
      "ciudad": "Test",
      "provincia": "Test",
      "pais": "Test",
      "codigoPostal": "12345"
    }
  },
  "items": [
    {
      "productoId": 1,
      "cantidad": 1,
      "precioUnitario": 10
    }
  ]
}

### [GET] Mis pedidos (200)
GET {{baseUrl}}/api/pedidos/me
Authorization: Bearer {{loginUser.response.body.$.token}}

### [GET] Mis pedidos paginados (200)
GET {{baseUrl}}/api/pedidos/me/paged?page=1&size=5
Authorization: Bearer {{loginUser.response.body.$.token}}

### [GET] Mi pedido por id (200)
GET {{baseUrl}}/api/pedidos/me/{{crearPedido.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}

### [PUT] Actualizar mi pedido (200)
PUT {{baseUrl}}/api/pedidos/me/{{crearPedido.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{
  "direccionEnvio": "Actualizado desde doc/http"
}

### [DELETE] Cancelar mi pedido (204)
DELETE {{baseUrl}}/api/pedidos/me/{{crearPedido.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}

# ----------------------- ADMINISTRADOR (ADMIN) ---------------------

### [POST] El admin tambien crea su pedido via /me (201) - id como pedidoAdmin
# @name pedidoAdmin
POST {{baseUrl}}/api/pedidos/me
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "destinatario": {
    "nombreCompleto": "Administrador",
    "email": "admin@test.com",
    "telefono": "+34123456789",
    "direccion": {
      "calle": "Avenida de la Prueba",
      "numero": "5",
      "ciudad": "Sevilla",
      "provincia": "Sevilla",
      "pais": "España",
      "codigoPostal": "41001"
    }
  },
  "items": [
    {
      "productoId": 3,
      "cantidad": 1,
      "precioUnitario": 30.5
    }
  ]
}

### [GET] Todos los pedidos (200)
GET {{baseUrl}}/api/pedidos
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Todos paginados (200)
GET {{baseUrl}}/api/pedidos/paged?page=1&size=10
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Pedido por id como admin (200)
GET {{baseUrl}}/api/pedidos/{{pedidoAdmin.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Error: id inexistente (404)
GET {{baseUrl}}/api/pedidos/999999999999999999999999
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [PUT] Actualizar estado (200)
PUT {{baseUrl}}/api/pedidos/{{pedidoAdmin.response.body.$.id}}/estado
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "Estado": "ENVIADO"
}

### [PUT] Actualizar pedido completo (200)
PUT {{baseUrl}}/api/pedidos/{{pedidoAdmin.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "Estado": "ENTREGADO",
  "direccionEnvio": "Actualizado por administrador desde doc/http"
}

### [DELETE] Eliminar pedido (204)
DELETE {{baseUrl}}/api/pedidos/{{pedidoAdmin.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
