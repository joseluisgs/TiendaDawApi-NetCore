# =====================================================================
# 05 - USUARIOS: CRUD de administrador y perfil propio (10 rutas)
#   - Administrador: lista, detalle, alta, baja y update de usuarios.
#   - Propio (USER): /api/users/me/profile (lee, actualiza, avatar, baja).
# ATENCION: el ultimo request elimina la cuenta propia de prueba.
# =====================================================================

@baseUrl = http://localhost:5031

### [LOGIN] Admin (200) - token como loginAdmin
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

### [SIGNUP] Usuario de prueba (201) - token como signupDemo
# @name signupDemo
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "username": "demo_{{$guid}}",
  "email": "demo_{{$guid}}@test.com",
  "password": "Test1234"
}

### [LOGIN] Login del usuario de prueba (200) - id y token como loginDemo
# @name loginDemo
POST {{baseUrl}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "{{signupDemo.response.body.$.user.username}}",
  "password": "Test1234"
}

# ------------------------- ADMINISTRADOR ---------------------------

### [GET] Listar usuarios (200)
GET {{baseUrl}}/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Usuario por id (200) - el del signup de prueba
GET {{baseUrl}}/api/users/{{loginDemo.response.body.$.user.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Error: id inexistente (404)
GET {{baseUrl}}/api/users/999999
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### [GET] Error: sin token (401)
GET {{baseUrl}}/api/users

### [POST] Crear usuario como admin (201) - id como crearUsuario
# @name crearUsuario
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "username": "newuser_{{$guid}}",
  "email": "newuser_{{$guid}}@test.com",
  "password": "User1234",
  "role": "USER"
}

### [PUT] Actualizar usuario creado (200)
PUT {{baseUrl}}/api/users/{{crearUsuario.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "email": "actualizado@test.com"
}

### [PATCH] Avatar de un usuario por id, con el propio token (200)
PATCH {{baseUrl}}/api/users/{{loginDemo.response.body.$.user.id}}/avatar
Authorization: Bearer {{loginDemo.response.body.$.token}}
Content-Type: application/json

{
  "avatarUrl": "https://ejemplo.com/avatar.png"
}

### [DELETE] Eliminar el usuario creado por admin (204)
DELETE {{baseUrl}}/api/users/{{crearUsuario.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

# -------------------------- PERFIL PROPIO --------------------------

### [GET] Mi perfil (200)
GET {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{loginDemo.response.body.$.token}}

### [PUT] Actualizar mi perfil (200)
PUT {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{loginDemo.response.body.$.token}}
Content-Type: application/json

{
  "email": "demo_actualizado@{{$guid}}.com"
}

### [PATCH] Actualizar mi avatar (200)
PATCH {{baseUrl}}/api/users/me/profile/avatar
Authorization: Bearer {{loginDemo.response.body.$.token}}
Content-Type: application/json

{
  "avatarUrl": "https://ejemplo.com/mi-avatar.png"
}

### [DELETE] Borrar mi cuenta de prueba (204) - ULTIMO REQUEST DEL FICHERO
DELETE {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{loginDemo.response.body.$.token}}
