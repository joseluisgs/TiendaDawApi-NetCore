# =====================================================================
# 03 - PRODUCTOS: CRUD, filtros, busqueda por categoria e imagen (8 rutas)
# Lecturas publicas; escrituras con rol ADMIN.
# =====================================================================

@baseUrl = http://localhost:5031

### [LOGIN] Admin (200) - token como loginAdmin
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

### [GET] Listar todos, publico (200)
GET {{baseUrl}}/api/productos

### [GET] Listar con filtros y paginacion (200)
GET {{baseUrl}}/api/productos?nombre=Laptop&precioMax=1500&stockMin=5&page=0&size=10&sortBy=precio&direction=desc

### [GET] Obtener por id (200) - semilla id=1
GET {{baseUrl}}/api/productos/1

### [GET] Obtener por categoria (200) - semilla categoria 1
GET {{baseUrl}}/api/productos/categoria/1

### [GET] Error: no existe (404)
GET {{baseUrl}}/api/productos/999999

### [POST] Crear como admin (201) - id como crearProducto
# @name crearProducto
POST {{baseUrl}}/api/productos
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Producto demo {{$guid}}",
  "descripcion": "Creado desde doc/http",
  "precio": 99.99,
  "stock": 10,
  "categoriaId": 1,
  "imagenUrl": "https://ejemplo.com/demo.png"
}

### [POST] Error: precio invalido (400)
POST {{baseUrl}}/api/productos
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Precio negativo",
  "descripcion": "Validacion de dominio",
  "precio": -100,
  "stock": 10,
  "categoriaId": 1
}

### [PUT] Actualizar completo el creado (200)
PUT {{baseUrl}}/api/productos/{{crearProducto.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Producto demo actualizado",
  "descripcion": "Actualizado desde doc/http",
  "precio": 79.99,
  "stock": 5,
  "categoriaId": 1
}

### [PATCH] Actualizar parcial (200) - solo precio y stock
PATCH {{baseUrl}}/api/productos/{{crearProducto.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "precio": 59.99,
  "stock": 3
}

### [PATCH] Subir imagen (200) - multipart; REST Client no admite binarios,
### con lo que el contenido del parte es texto con Content-Type image/png.
### Para subir un archivo real usa la coleccion E2E (Bruno/Postman).
PATCH {{baseUrl}}/api/productos/{{crearProducto.response.body.$.id}}/imagen
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: multipart/form-data; boundary=abc123

--abc123
Content-Disposition: form-data; name="image"; filename="demo.png"
Content-Type: image/png

contenido-de-ejemplo
--abc123--

### [DELETE] Eliminar el creado (204)
DELETE {{baseUrl}}/api/productos/{{crearProducto.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
