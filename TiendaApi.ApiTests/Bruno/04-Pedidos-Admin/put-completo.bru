meta {
  name: PUT - Actualizar completo
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/pedidos/{{pedidoId}}
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "estado": "ENTREGADO",
      "notas": "Pedido actualizado por administrador"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "id");
}
