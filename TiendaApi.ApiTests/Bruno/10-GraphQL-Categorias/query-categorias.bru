meta {
  name: QUERY - Obtener todas las categorías
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
  }
  body {
    {
      "query": "query { categorias { id nombre } }"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.categorias);
  assertIsArray(response.body.data.categorias);
  assertTrue(response.body.errors === undefined || response.body.errors === null);
}
