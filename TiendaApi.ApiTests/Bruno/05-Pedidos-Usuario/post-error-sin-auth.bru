meta {
  name: POST - Error sin auth
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/pedidos/me
  headers {
    Content-Type: application/json
  }
  body {
    {
      "cliente": {
        "nombreCompleto": "Test",
        "email": "test@test.com",
        "telefono": "+34123456789",
        "direccion": {
          "calle": "Calle Test",
          "numero": "1",
          "ciudad": "Test",
          "provincia": "Test",
          "pais": "Test",
          "codigoPostal": "12345"
        }
      },
      "lineasPedido": [
        {
          "idProducto": 1,
          "cantidad": 1,
          "precioUnitario": 100
        }
      ]
    }
  }
}

tests {
  assertStatus(response.status, 401);
}
