meta {
  name: PATCH - Actualizar parcial (Admin)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/productos/{{productoId}}
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "precio": 799.99,
      "stock": 30
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertEquals(response.body.precio, 799.99);
  assertEquals(response.body.stock, 30);
}
