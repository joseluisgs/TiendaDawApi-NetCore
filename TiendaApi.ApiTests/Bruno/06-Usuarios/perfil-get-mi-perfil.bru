meta {
  name: GET Mi Perfil
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/users/me/profile
  headers {
    Authorization: Bearer {{userToken}}
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "username");
  assertEquals(response.body.username, bru.getVar("userUsername"));
}
