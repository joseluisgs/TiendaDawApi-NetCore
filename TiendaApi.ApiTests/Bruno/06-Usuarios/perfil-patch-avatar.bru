meta {
  name: PATCH Actualizar Avatar
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/users/me/profile/avatar
  headers {
    Content-Type: application/json
    Authorization: Bearer {{userToken}}
  }
  body {
    {
      "avatarUrl": "https://ejemplo.com/avatar.jpg"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "avatarUrl");
}
