meta {
  name: PUT Actualizar Mi Perfil
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/users/me/profile
  headers {
    Content-Type: application/json
    Authorization: Bearer {{userToken}}
  }
  body {
    {
      "firstName": "Juan",
      "lastName": "Pérez",
      "email": "{{userUsername}}@updated.com"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "id");
  assertEquals(response.body.firstName, "Juan");
  assertEquals(response.body.lastName, "Pérez");
}
