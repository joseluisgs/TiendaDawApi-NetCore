meta {
  name: POST - Crear (Admin)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/categorias
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "nombre": "Electrónica Test",
      "descripcion": "Categoría de prueba para E2E"
    }
  }
}

tests {
  assertStatus(response.status, 201);
  assertPropertyExists(response.body, "id");
  assertEquals(response.body.nombre, "Electrónica Test");
  assertEquals(response.body.descripcion, "Categoría de prueba para E2E");
  
  bru.setVar("categoriaId", response.body.id);
}
