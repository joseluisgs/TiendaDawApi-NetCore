meta {
  name: GET By Id (Público)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/categorias/1
  headers {
    Content-Type: application/json
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "id");
  assertPropertyExists(response.body, "nombre");
  assertIsNumber(response.body.id);
}
