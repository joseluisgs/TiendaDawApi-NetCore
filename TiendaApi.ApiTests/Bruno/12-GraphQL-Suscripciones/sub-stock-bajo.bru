meta {
  name: SUBSCRIPTION - onStockBajo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "query": "subscription { onStockBajo { productoId nombre stockMinimo umbral } }"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.onStockBajo);
}
