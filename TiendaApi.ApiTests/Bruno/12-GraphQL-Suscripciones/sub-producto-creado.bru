meta {
  name: SUBSCRIPTION - onProductoCreado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "query": "subscription { onProductoCreado { productoId nombre precio stock createdAt } }"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.onProductoCreado);
}
