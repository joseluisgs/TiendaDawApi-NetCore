{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Name": "TiendaApi",
    "Version": "1.0.0",
    "Culture": "es-ES",
    "Description": "API REST educativa - Entorno de Producción"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${POSTGRES_CONNECTION_STRING}",
    "MongoDB": "${MONGODB_CONNECTION_STRING}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "MongoDbSettings": {
    "ConnectionString": "${MONGODB_CONNECTION_STRING}",
    "DatabaseName": "tienda",
    "PedidosCollection": "pedidos"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "TiendaApi",
    "Audience": "TiendaApi",
    "ExpireMinutes": "60"
  },
  "Smtp": {
    "Host": "${SMTP_HOST}",
    "Port": "${SMTP_PORT}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "TiendaApi Notifications",
    "AdminEmail": "${ADMIN_EMAIL}",
    "EnableSsl": true
  },
  "Cache": {
    "DefaultExpirationMinutes": "5",
    "ProductoCacheTTLMinutes": "10"
  },
  "Storage": {
    "UploadPath": "images/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif"],
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/gif"]
  },
  "Database": {
    "Seed": {
      "AlwaysSeed": false,
      "Description": "En producción solo siembra datos si no existen tablas"
    }
  }
}
