meta {
  name: [004] SIGNUP - Error email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "username": "testuser",
      "email": "email-invalido",
      "password": "Test1234!"
  }
}

script:post-response {
  test("Signup invalid email - Status 400 Bad Request", function () {
      test("Diferencia por modo: 400 en Custom / 422 en Identity", function () { expect([400, 422]).to.include(res.getStatus()); });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Signup con email inválido debe retornar 400
}
