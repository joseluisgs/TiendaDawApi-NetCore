meta {
  name: [003] SIGNUP - Error username
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "username": "",
      "email": "test@test.com",
      "password": "Test1234!"
  }
}

script:post-response {
  test("Signup validation - Status 400 Bad Request", function () {
      test("Diferencia por modo: 400 en Custom / 422 en Identity", function () { expect([400, 422]).to.include(res.getStatus()); });
  });
  
  test("Signup validation - Has error message", function () {
      const jsonData = res.getBody();
      expect(jsonData.errors).to.not.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Signup con username vacío debe retornar 400
}
