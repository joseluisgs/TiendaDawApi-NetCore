meta {
  name: [064] QUERY - Categoría por ID
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
  }
  body {
    {
      "query": "query($id: Long!) { categoria(id: $id) { id nombre } }",
      "variables": {
        "id": 1
      }
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.categoria);
  assertIsObject(response.body.data.categoria);
  assertPropertyExists(response.body.data.categoria.id);
}
