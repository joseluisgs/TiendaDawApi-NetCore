meta {
  name: [052] GET Mis Pedidos Paginados
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/pedidos/me/paged
  headers {
    Authorization: Bearer {{userToken}}
  }
  query {
    page: 1
    size: 5
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "items");
  assertPropertyExists(response.body, "page");
  assertPropertyExists(response.body, "totalItems");
}
