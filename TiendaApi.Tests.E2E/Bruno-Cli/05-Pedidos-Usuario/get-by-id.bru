meta {
  name: [053] GET By Id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/pedidos/me/{{pedidoId}}
  headers {
    Authorization: Bearer {{userToken}}
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "id");
  assertEquals(response.body.id, Number(bru.getVar("pedidoId")));
}
