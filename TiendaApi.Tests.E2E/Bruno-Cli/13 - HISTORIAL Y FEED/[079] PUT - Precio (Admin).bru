meta {
  name: [079] PUT - Precio (Admin)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/productos/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
      "nombre": "Laptop Dell XPS 15",
      "descripcion": "Laptop de alto rendimiento",
      "precio": 1111.11,
      "stock": 10,
      "categoriaId": 1,
      "proveedorCodigo": "Distribuc01"
  }
}

script:post-response {
  test("Historial PUT - Status 200", function () {
      expect(res.getStatus()).to.equal(200);
  });

  // El PUT es de reemplazo completo: si no se envía proveedorCodigo se DESVINCULA
  // el proveedor del producto (rompe a [065] GraphQL después). Se envía y verifica.
  test("Historial PUT - Conserva el proveedor Distribuc01", function () {
      const jsonData = res.getBody();
      expect(jsonData.proveedor).to.be.an('object');
      expect(jsonData.proveedor.codigo).to.equal('Distribuc01');
  });

  // Guardar el precio nuevo para comprobar que aparece en la serie.
  if (res.getStatus() === 200) {
      const jsonData = res.getBody();
      bru.setVar("precioNuevo", String(jsonData.precio));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Update de precio sobre el producto seed. El historial solo registra un punto si el precio CAMBIO (no es un log de ediciones): con precio fijo 1111.11 (distinto al precio seed 1299.99) y el protocolo de BD fresh por corrida, SIEMPRE hay cambio. Bruno no soporta randomInt con argumentos: con una variable sin expandir el JSON salia invalido (400).
}