meta {
  name: Signin - Usuario
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/signin
  headers {
    Content-Type: application/json
  }
  body {
    {
      "username": "{{userUsername}}",
      "password": "{{userPassword}}"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "token");
  assertPropertyExists(response.body, "user");
  assertEquals(response.body.user.role, "USER");
  
  bru.setVar("userToken", response.body.token);
}
