meta {
  name: Signup - Error username vacío
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  headers {
    Content-Type: application/json
  }
  body {
    {
      "username": "",
      "email": "test@test.com",
      "password": "Test1234"
    }
  }
}

tests {
  assertStatus(response.status, 400);
  assertPropertyExists(response.body, "message");
}
