meta {
  name: [001] Signup - Usuario nuevo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  headers {
    Content-Type: application/json
  }
  body {
    {
      "username": "{{testUsername}}",
      "email": "{{testUsername}}@test.com",
      "password": "Test1234"
    }
  }
}

tests {
  assertStatus(response.status, 201);
  assertPropertyExists(response.body, "user");
  assertPropertyExists(response.body, "token");
  assertEquals(response.body.user.role, "USER");
  
  bru.setVar("userToken", response.body.token);
}

vars:pre-request {
  const timestamp = Date.now();
  bru.setVar("testUsername", `testuser_${timestamp}`);
}
