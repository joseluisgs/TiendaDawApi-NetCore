meta {
  name: [075] QUERY - misPedidos (user) - solo suyos
  type: graphql
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:graphql {
  query { misPedidos { id userId estado } }
}

script:post-response {
  test("GraphQL MisPedidos - Status 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });

  test("GraphQL MisPedidos - Solo pedidos del usuario autenticado", function () {
      const jsonData = res.getBody();
      expect(jsonData.errors).to.be.undefined;
      expect(jsonData.data.misPedidos).to.be.an('array');
      // userToken es de userdaw (id 2, seed): el filtro sale del claim del JWT,
      // nunca puede aparecer un pedido de otro usuario.
      for (const p of jsonData.data.misPedidos) {
          expect(p.userId).to.equal(2);
          expect(p.id).to.be.a('string');
          expect(p.estado).to.be.a('string');
      }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  GraphQL: misPedidos - los del usuario autenticado (claim NameIdentifier)
}
