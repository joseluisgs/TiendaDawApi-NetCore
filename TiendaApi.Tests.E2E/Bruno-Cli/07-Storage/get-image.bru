meta {
  name: GET Image
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/storage/uploads/productos/test-image.png
}

tests {
  const validStatuses = [200, 404];
  assertTrue(validStatuses.includes(response.status));
  
  if (response.status === 200) {
    const contentType = response.headers.get("Content-Type");
    assertTrue(contentType.startsWith("image/"));
  }
}
