meta {
  name: MUTATION - Eliminar producto (Admin)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "query": "mutation($id: Long!) { deleteProducto(id: $id) }",
      "variables": {
        "id": Number(bru.getVar("graphqlProductoId"))
      }
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertEquals(response.body.data.deleteProducto, true);
}
