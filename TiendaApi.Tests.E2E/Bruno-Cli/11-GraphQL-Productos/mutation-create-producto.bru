meta {
  name: [067] MUTATION - Crear producto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "query": "mutation($input: CreateProductoInput!) { createProducto(input: $input) { id nombre precio stock } }",
      "variables": {
        "input": {
          "nombre": "GraphQL Test Producto",
          "descripcion": "Producto de prueba desde GraphQL",
          "precio": 99.99,
          "stock": 10,
          "categoriaId": 1
        }
      }
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.createProducto);
  assertEquals(response.body.data.createProducto.nombre, "GraphQL Test Producto");
  assertEquals(response.body.data.createProducto.precio, 99.99);
  
  bru.setVar("graphqlProductoId", response.body.data.createProducto.id);
}
