meta {
  name: [065] QUERY - Productos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
  }
  body {
    {
      "query": "query { productos { id nombre precio stock } }"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "data");
  assertPropertyExists(response.body.data.productos);
  assertIsArray(response.body.data.productos);
  assertTrue(response.body.errors === undefined || response.body.errors === null);
}
