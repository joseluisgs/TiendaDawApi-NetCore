meta {
  name: [068] MUTATION - Actualizar producto
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "query": "mutation($id: Long!, $input: UpdateProductoInput!) { updateProducto(id: $id, input: $input) { id nombre precio stock } }",
      "variables": {
        "id": Number(bru.getVar("graphqlProductoId")),
        "input": {
          "precio": 149.99,
          "stock": 20
        }
      }
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertEquals(response.body.data.updateProducto.precio, 149.99);
  assertEquals(response.body.data.updateProducto.stock, 20);
}
