meta {
  name: MUTATION - Crear producto (sin auth)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  headers {
    Content-Type: application/json
  }
  body {
    {
      "query": "mutation($input: CreateProductoInput!) { createProducto(input: $input) { id nombre } }",
      "variables": {
        "input": {
          "nombre": "Test",
          "precio": 99,
          "stock": 10,
          "categoriaId": 1
        }
      }
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "errors");
  assertIsArray(response.body.errors);
  assertContains(response.body.errors[0].message, "Unauthorized");
}
