    token: {{adminToken}}
}

script:post-response {
    test("Estadisticas Precios inexistente - Status 404", function () {
        expect(res.getStatus()).to.equal(404);
    });
}

settings {
    encodeUrl: true
}

docs {
    Un producto sin histórico (o inexistente) responde 404.
}
