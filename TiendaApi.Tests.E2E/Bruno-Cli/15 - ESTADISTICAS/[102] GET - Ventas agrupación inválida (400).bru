    token: {{adminToken}}
}

script:post-response {
    test("Estadisticas Ventas invalida - Status 400", function () {
        expect(res.getStatus()).to.equal(400);
    });
}

settings {
    encodeUrl: true
}

docs {
    Solo se admiten dia, semana y mes.
}
