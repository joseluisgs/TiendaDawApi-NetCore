meta {
  name: [012] GET All con filtros
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/categorias
  headers {
    Content-Type: application/json
  }
  query {
    nombre: Elec
    page: 0
    size: 10
    sortBy: id
    direction: asc
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "items");
}
