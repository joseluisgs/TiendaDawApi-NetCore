meta {
  name: [019] PUT - Actualizar (Admin)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/categorias/{{categoriaId}}
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "nombre": "Electrónica Test Actualizada",
      "descripcion": "Nueva descripción"
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertEquals(response.body.nombre, "Electrónica Test Actualizada");
  assertEquals(response.body.descripcion, "Nueva descripción");
}
