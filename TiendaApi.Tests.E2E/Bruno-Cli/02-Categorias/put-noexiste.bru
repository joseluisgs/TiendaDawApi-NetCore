meta {
  name: [020] PUT - No existe
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/categorias/999999
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "nombre": "Test",
      "descripcion": "Test"
    }
  }
}

tests {
  assertStatus(response.status, 404);
}
