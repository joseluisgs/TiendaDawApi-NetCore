meta {
  name: SUBSCRIPTION - onProductoCreado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"query": "subscription { onProductoCreado { productoId nombre precio stock createdAt } }"}
}

script:post-response {
  test("GraphQL Subscription ProductoCreado - Status 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("GraphQL Subscription ProductoCreado - Has data", function () {
      const jsonData = res.getBody();
      expect(jsonData.data).to.be.an('object');
      expect(jsonData.data.onProductoCreado).to.be.an('object');
  });
}

settings {
  encodeUrl: true
}

docs {
  GraphQL: Suscripción a productos creados (requiere token JWT)
}
