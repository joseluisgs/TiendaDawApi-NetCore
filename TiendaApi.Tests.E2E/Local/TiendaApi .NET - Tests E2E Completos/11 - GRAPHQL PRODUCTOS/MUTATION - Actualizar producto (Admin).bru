meta {
  name: MUTATION - Actualizar producto (Admin)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"query": "mutation($id: Long!, $input: UpdateProductoInput!) { updateProducto(id: $id, input: $input) { id nombre precio stock } }", "variables": {"id": {{graphqlProductoId}}, "input": {"precio": 149.99, "stock": 20}}}
}

script:post-response {
  test("GraphQL UpdateProducto - Status 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("GraphQL UpdateProducto - Returns updated producto", function () {
      const jsonData = res.getBody();
      expect(jsonData.data.updateProducto.precio).to.equal(149.99);
      expect(jsonData.data.updateProducto.stock).to.equal(20);
  });
}

settings {
  encodeUrl: true
}

docs {
  GraphQL: Actualiza producto (requiere token ADMIN)
}
