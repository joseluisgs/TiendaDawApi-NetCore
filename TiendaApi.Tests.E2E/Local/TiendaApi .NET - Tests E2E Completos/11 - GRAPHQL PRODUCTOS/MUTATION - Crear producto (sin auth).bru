meta {
  name: MUTATION - Crear producto (sin auth)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {"query": "mutation($input: CreateProductoInput!) { createProducto(input: $input) { id nombre } }", "variables": {"input": {"nombre": "Test", "precio": 99, "stock": 10, "categoriaId": 1}}}
}

script:post-response {
  test("GraphQL CreateProducto NoAuth - Returns error", function () {
      const jsonData = res.getBody();
      expect(jsonData.errors).to.be.an('array');
      expect(jsonData.errors[0].message).to.include('Unauthorized');
  });
}

settings {
  encodeUrl: true
}

docs {
  GraphQL: Crear producto sin token debe fallar
}
