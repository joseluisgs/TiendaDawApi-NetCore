meta {
  name: MUTATION - Eliminar producto (Admin)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"query": "mutation($id: Long!) { deleteProducto(id: $id) }", "variables": {"id": {{graphqlProductoId}}}}
}

script:post-response {
  test("GraphQL DeleteProducto - Status 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("GraphQL DeleteProducto - Returns true", function () {
      const jsonData = res.getBody();
      expect(jsonData.data.deleteProducto).to.equal(true);
  });
}

settings {
  encodeUrl: true
}

docs {
  GraphQL: Elimina producto (requiere token ADMIN)
}
