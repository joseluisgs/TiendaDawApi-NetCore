meta {
  name: GET By Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/pedidos/{{pedidoId}}
  headers {
    Authorization: Bearer {{adminToken}}
  }
}

tests {
  assertStatus(response.status, 200);
  assertPropertyExists(response.body, "id");
  assertPropertyExists(response.body, "estado");
  assertPropertyExists(response.body, "cliente");
  assertPropertyExists(response.body, "lineasPedido");
}
