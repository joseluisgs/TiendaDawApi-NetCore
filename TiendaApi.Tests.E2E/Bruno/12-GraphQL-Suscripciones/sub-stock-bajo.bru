meta {
  name: SUBSCRIPTION - onStockBajo
  type: ws
  seq: 3
}

ws {
  url: ws://localhost:5031/graphql
  body: ws
  auth: inherit
}

auth:bearer {
  token: {{adminToken}}
}

body:ws {
  name: subscribe
  type: json
  content: '''
    {"query": "subscription { onStockBajo { productoId nombre stockActual umbralStock detectedAt } }"}
  '''
}

script:post-response {
  test("GraphQL Subscription StockBajo - Status 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("GraphQL Subscription StockBajo - Has data", function () {
    const jsonData = res.getBody();
    expect(jsonData.data).to.be.an('object');
    expect(jsonData.data.onStockBajo).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  GraphQL: Suscripción a stock bajo (requiere token JWT)
}