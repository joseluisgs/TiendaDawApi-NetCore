meta {
  name: POST - Crear usuario
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/users
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "username": "newuser",
      "email": "newuser@test.com",
      "password": "User1234",
      "role": "USER"
    }
  }
}

tests {
  assertStatus(response.status, 201);
  assertPropertyExists(response.body, "id");
  assertEquals(response.body.username, "newuser");
  assertEquals(response.body.email, "newuser@test.com");
  
  bru.setVar("testUserId", response.body.id);
}
