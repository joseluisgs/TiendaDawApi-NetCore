meta {
  name: PUT - Actualizar (Admin)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/productos/{{productoId}}
  headers {
    Content-Type: application/json
    Authorization: Bearer {{adminToken}}
  }
  body {
    {
      "nombre": "Laptop HP Test Actualizado",
      "descripcion": "Nueva descripción",
      "precio": 899.99,
      "stock": 40,
      "categoriaId": 1
    }
  }
}

tests {
  assertStatus(response.status, 200);
  assertEquals(response.body.nombre, "Laptop HP Test Actualizado");
  assertEquals(response.body.precio, 899.99);
}
