meta {
  name: POST - Crear pedido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/pedidos/me
  headers {
    Content-Type: application/json
    Authorization: Bearer {{userToken}}
  }
  body {
    {
      "cliente": {
        "nombreCompleto": "Juan Perez",
        "email": "juanperez@test.com",
        "telefono": "+34123456789",
        "direccion": {
          "calle": "Calle Mayor",
          "numero": "10",
          "ciudad": "Madrid",
          "provincia": "Madrid",
          "pais": "España",
          "codigoPostal": "28001"
        }
      },
      "lineasPedido": [
        {
          "idProducto": 1,
          "cantidad": 2,
          "precioUnitario": 999.99
        }
      ]
    }
  }
}

tests {
  assertStatus(response.status, 201);
  assertPropertyExists(response.body, "id");
  assertEquals(response.body.estado, "PENDIENTE");
  assertPropertyExists(response.body, "cliente");
  
  bru.setVar("pedidoId", response.body.id);
}
