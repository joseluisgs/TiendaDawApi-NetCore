meta {
  name: [051b] SIGNUP - Cuenta dedicada
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "username": "delcuenta_{{tsDedicated}}",
      "email": "delcuenta_{{tsDedicated}}@test.com",
      "password": "Test1234"
  }
}

script:pre-request {
  // Timestamp único por ejecución (sintaxis nativa bru, no pm)
  bru.setVar("tsDedicated", Date.now());
}

script:post-response {
  // Cuenta DEDICADA para el [051] DELETE Mi Cuenta: así esta prueba no borra
  // el usuario seed (userdaw) y las suites siguientes siguen pudiendo usarlo.
  test("Signup cuenta dedicada - 201 con token", function () {
      expect(res.getStatus()).to.equal(201);
  });

  if (res.getStatus() === 201) {
      const jsonData = res.getBody();
      bru.setVar("delCuentaToken", jsonData.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Cuenta dedicada para [051]. Antes el borrado era del seed userdaw y rompía
  las suites siguientes (paridad con Automation, que ya usaba cuenta dedicada).
}
