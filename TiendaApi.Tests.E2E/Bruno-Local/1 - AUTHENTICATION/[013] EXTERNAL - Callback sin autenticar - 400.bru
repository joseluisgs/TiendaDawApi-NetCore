meta {
  name: [013] EXTERNAL - Callback sin autenticar - 400
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/auth/external-callback
  body: none
  auth: inherit
}

script:post-response {
  test("External Callback sin principal - 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  El callback sin haber pasado por el proveedor (sin principal autenticado)
  responde 400: no hay claims de Google/GitHub/Microsoft que vincular.
}
