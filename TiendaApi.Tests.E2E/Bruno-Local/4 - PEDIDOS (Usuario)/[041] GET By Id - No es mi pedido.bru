  token: {{userToken}}
}

script:post-response {
  test("Pedidos My GetById Forbidden - Status 404 Not Found", function () {
      expect(res.getStatus()).to.equal(404);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
