meta {
  name: [074] QUERY - pedidos sin token - authoriz
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query { pedidos { id } }
}

script:post-response {
  test("GraphQL Pedidos NoAuth - Requiere autenticacion", function () {
      const jsonData = res.getBody();
      expect(jsonData.errors).to.be.an('array').that.is.not.empty;
      expect(jsonData.errors[0].message.toLowerCase()).to.include('authoriz');
      expect(jsonData.data).to.not.be.ok;  // data es null en errores de autorizacion
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  GraphQL: pedidos sin token debe fallar
}
